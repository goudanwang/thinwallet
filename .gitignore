# Local toolchains, snapshots, scratch space, and build caches.
.tools/
archive/
tmp/
**/target/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.gradle/
**/.cache/

# Generated circuit and native build artifacts.
**/build/*
!**/build/.gitkeep
**/*.o
**/*.a
**/*.so
**/*.rlib
**/*.rmeta
**/*.d
**/*.wasm
**/*.r1cs
**/*.wtns
**/*.zkey
**/*.ptau
**/*.apk
**/*.aab

# Proofs, tokens, private inputs, and device-side state must stay local.
**/*.proof
**/*.pbmo
**/*.token
**/*.key
**/*.keystore
**/*.jks
**/*.pem
**/*.p12
**/id_rsa*
**/id_ed25519*
**/.env
**/.env.*
**/private/
**/secrets/
**/tokens/
**/--invocation/
experiments/android_phase5g_lowend/private/

# Raw benchmark campaigns and generated reports are intentionally not versioned.
**/results/
**/results.json
**/*_results.json
/results/*
!/results/
!/results/standalone_verifier.csv
!/results/selected_path_tests.txt
!/results/selected_vs_pbmo.csv
**/*.log
**/*.aux
**/official-build/
experiments/libspartan/*_inventory.json

# Generated paper/media outputs and third-party reference snapshots.
images/
paper_figures/
paper_tables/
**/references/
docs/*.pdf

